# ============================================================
# Portal de Recrutamento (React / TanStack Start) — imagem Railway
#
# Serve exatamente o mesmo interface da pré-visualização Lovable,
# com renderização no servidor (Node), a partir deste repositório.
#
# No Railway: novo serviço -> Dockerfile Path = Dockerfile.portal
# ============================================================

# ---------- 1) Compilação ----------
FROM oven/bun:1 AS build
WORKDIR /app

COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile || bun install

COPY . .

# Gera a saída Nitro para servidor Node (.output/server/index.mjs)
ENV NITRO_PRESET=node-server
ENV NODE_ENV=production
RUN bun run build

# ---------- 2) Execução ----------
FROM node:22-alpine
WORKDIR /app

RUN addgroup -S app && adduser -S app -G app
COPY --from=build /app/.output ./.output
USER app

ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

CMD ["node", ".output/server/index.mjs"]
