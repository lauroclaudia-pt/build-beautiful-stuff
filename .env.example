# ============================================================
# Variáveis do serviço Java no Railway
# Cole estas referências nas Variables DO SERVIÇO JAVA.
# O serviço da base de dados deve chamar-se exatamente "Postgres".
# ============================================================

# ---- Base de dados (PostgreSQL 18) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# ---- JPA / Flyway ----
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# ---- Aplicação ----
SPRING_PROFILES_ACTIVE=prod
PORT=8080
JAVA_OPTS=-XX:MaxRAMPercentage=75

# ---- CORS: domínios do frontend autorizados ----
APP_CORS_ALLOWED_ORIGINS=https://o-seu-projeto.lovable.app,http://localhost:8080

# ---- Correio eletrónico (notificações aos candidatos) ----
SPRING_MAIL_HOST=smtp.ipma.pt
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=noreply-rh@ipma.pt
SPRING_MAIL_PASSWORD=alterar
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
APP_MAIL_FROM=noreply-rh@ipma.pt

# ---- Utilizador administrador inicial ----
APP_ADMIN_EMAIL=admin@ipma.pt
APP_ADMIN_PASSWORD=alterar-na-primeira-entrada
